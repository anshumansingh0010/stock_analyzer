  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "nodemon": "^3.0.3",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
