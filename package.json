{
  "name": "nifty50gpt",
  "version": "1.0.0",
  "description": "AI-powered financial intelligence assistant for Nifty 50 stocks",
  "main": "dist/server/index.js",
  "type": "module",
  "workspaces": [
    "client-react"
  ],
  "scripts": {
    "start": "node dist/server/index.js",
    "dev": "tsx watch server/index.ts",
    "server:build": "tsc",
    "client": "cd client-react && npm run dev",
    "client:build": "cd client-react && npm run build",
    "client:legacy": "cd client && npx serve ."
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "axios": "^1.6.7",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.5",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.1.0",
    "mongoose": "^8.3.0",
    "nodemailer": "^10.0.13",
    "openai": "^4.28.0",
    "rss-parser": "^3.13.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "nodemon": "^3.0.3",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
