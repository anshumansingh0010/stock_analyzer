# ═══════════════════════════════════════════════
# Nifty50GPT / Stock Sense — Environment Setup
# ═══════════════════════════════════════════════

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS & Security Settings
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Nodemailer / Auth Configuration
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=500

# LLM Provider Configuration ("openai" or "gemini")
LLM_PROVIDER=gemini
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_KEY=your_gemini_chat_key_here

# Google Auth
GOOGLE_CLIENT_ID=your_google_client_id_here

# Firebase Phone Auth
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
FIREBASE_PROJECT_ID=your_project_id

# Market Data Providers (Optional / Integration)
GROWW_API_KEY=your_groww_api_key_here
GROWW_SECRET_KEY=your_groww_secret_key_here

# Database Configuration (MongoDB)
# Provide MongoDB URI for persistence, or leave empty for in-memory mode
MONGODB_URI=mongodb://stockadmin:stockpassword123@localhost:27017/stock_sense_ai?authSource=admin

# Market Data Caching
MARKET_DATA_CACHE_TTL_MS=60000
DISABLE_NEWS_SCHEDULER=false
